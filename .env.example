# --- Database -------------------------------------------------------------
# Production: a PostgreSQL connection string.
#   DATABASE_URL=postgres://ledger:ledger@localhost:5432/ledger
# Local development without Docker: embedded PostgreSQL (PGlite) stored on disk.
DATABASE_URL=pglite:./.data/pglite

# --- Auth -----------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# When "true", new accounts must verify their email before signing in.
REQUIRE_EMAIL_VERIFICATION=false

# --- Email (optional) -----------------------------------------------------
# Without SMTP settings, verification/reset links are written to the server log (dev only).
# EMAIL_FROM=Ledger <no-reply@example.com>

# --- AI assistant (optional) ----------------------------------------------
# Without a key the assistant runs in "direct answers" mode using the same calculation tools.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Scheduler (optional) ------------------------------------------------
# Bearer token for POST /api/cron/notifications (see docs/DEPLOYMENT.md). Unset = route disabled.
# CRON_SECRET=

# --- Logging --------------------------------------------------------------
LOG_LEVEL=info

# Bank credential encryption key (required in production if bank connections are enabled)
# TOKEN_ENCRYPTION_KEY=

# Postgres pool / TLS (production)
# DATABASE_POOL_MAX=10
# DATABASE_SSL=true
# MIGRATE_ON_START=false

# Email delivery via Resend (optional)
# RESEND_API_KEY=
